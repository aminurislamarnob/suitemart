				},
				{
					"slug": "neutral-400",
					"color": "#b6b6b7",
					"name": "Neutral 400"
				},
				{
					"slug": "neutral-500",
					"color": "#7e7f80",
					"name": "Neutral 500"
				},
				{
					"slug": "neutral-600",
					"color": "#5c5d5f",
					"name": "Neutral 600"
				},
				{
					"slug": "neutral-700",
					"color": "#414245",
					"name": "Neutral 700"
				},
				{
					"slug": "neutral-800",
					"color": "#26282a",
					"name": "Neutral 800"
				},
				{
					"slug": "neutral-900",
					"color": "#0b0d10",
					"name": "Neutral 900"
				},
				{
					"slug": "success",
					"color": "#15803d",
					"name": "Success"
				},
				{
					"slug": "warning",
					"color": "#a35a00",
					"name": "Warning"
				},
				{
					"slug": "error",
					"color": "#c81e2b",
					"name": "Error"
				}
			]
		},
		"custom": {
			"color": {
				"scrim": "rgba(11, 13, 16, 0.45)",
				"overlay": "rgba(11, 13, 16, 0.08)"
			},
			"radius": {
				"sm": "2px",
				"md": "3px",
				"lg": "4px",
				"pill": "999px"
			}
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "800",
					"letterSpacing": "0.01em",
					"textTransform": "uppercase"
				}
			},
			"h6": {
				"typography": {
					"letterSpacing": "0.12em"
				}
			}
		}
	}
}

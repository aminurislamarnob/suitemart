{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Velocity",
	"description": "Race red against graphite, uppercase headings, corners barely softened — for sport and outdoor.",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#0b0d10",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#c81e2b",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#1b2027",

{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Midnight",
	"description": "A dark, high-contrast variation for electronics and tech stores.",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#0d1117",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#f2f4f8",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#5b9dff",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#c7d2e0",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#ffb347",
					"name": "Accent"
				},
				{
					"slug": "neutral-100",
					"color": "#161c26",
					"name": "Neutral 100"
				},
				{
					"slug": "neutral-200",
					"color": "#1f2733",
					"name": "Neutral 200"
				},
				{
					"slug": "neutral-300",
					"color": "#2b3543",
					"name": "Neutral 300"
				},
				{
					"slug": "neutral-400",
					"color": "#414d5e",
					"name": "Neutral 400"
				},
				{
					"slug": "neutral-500",
					"color": "#697687",
					"name": "Neutral 500"
				},
				{
					"slug": "neutral-600",
					"color": "#93a0b1",
					"name": "Neutral 600"
				},
				{
					"slug": "neutral-700",
					"color": "#b8c3d1",
					"name": "Neutral 700"
				},
				{
					"slug": "neutral-800",
					"color": "#dbe2ea",
					"name": "Neutral 800"
				},
				{
					"slug": "neutral-900",
					"color": "#f2f4f8",
					"name": "Neutral 900"
				},
				{
					"slug": "success",
					"color": "#4ade80",
					"name": "Success"
				},
				{
					"slug": "warning",
					"color": "#fbbf24",
					"name": "Warning"
				},
				{
					"slug": "error",
					"color": "#f87171",
					"name": "Error"
				}
			]
		},
		"custom": {
			"color": {
				"scrim": "rgba(3, 6, 12, 0.7)",
				"overlay": "rgba(242, 244, 248, 0.08)"
			},
			"radius": {
				"sm": "4px",
				"md": "8px",
				"lg": "16px",
				"pill": "999px"
			}
		}
	},
	"styles": {
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		}
	}
}

				},
				{
					"slug": "neutral-800",
					"color": "#2f2e29",
					"name": "Neutral 800"
				},
				{
					"slug": "neutral-900",
					"color": "#16150f",
					"name": "Neutral 900"
				},
				{
					"slug": "success",
					"color": "#2f6b3a",
					"name": "Success"
				},
				{
					"slug": "warning",
					"color": "#8a5a12",
					"name": "Warning"
				},
				{
					"slug": "error",
					"color": "#9a2617",
					"name": "Error"
				}
			]
		},
		"custom": {
			"color": {
				"scrim": "rgba(22, 21, 15, 0.45)",
				"overlay": "rgba(22, 21, 15, 0.08)"
			},
			"radius": {
				"sm": "0",
				"md": "2px",
				"lg": "2px",
				"pill": "999px"
			}
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--serif)",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"letterSpacing": "0.12em"
				}
			}
		}
	}
}

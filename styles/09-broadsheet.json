{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Broadsheet",
	"description": "Serif throughout on newsprint ivory, with a single red — for editorial and content-led shops.",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#fdfcf7",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#16150f",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#9a2617",

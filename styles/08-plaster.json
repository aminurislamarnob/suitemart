{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Plaster",
	"description": "Greyscale with no corner radius and light headings — for a gallery-quiet catalogue.",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#111111",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#3f3f46",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#27272a",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#6b6b6b",
					"name": "Accent"
				},
				{
					"slug": "neutral-100",
					"color": "#f5f5f5",
					"name": "Neutral 100"
				},
				{
					"slug": "neutral-200",
					"color": "#eaeaea",
					"name": "Neutral 200"
				},
				{
					"slug": "neutral-300",
					"color": "#d9d9d9",
					"name": "Neutral 300"
				},
				{
					"slug": "neutral-400",
					"color": "#b8b8b8",
					"name": "Neutral 400"
				},
				{
					"slug": "neutral-500",
					"color": "#818181",
					"name": "Neutral 500"
				},
				{
					"slug": "neutral-600",
					"color": "#606060",
					"name": "Neutral 600"
				},
				{
					"slug": "neutral-700",
					"color": "#454545",
					"name": "Neutral 700"
				},
				{
					"slug": "neutral-800",
					"color": "#2b2b2b",
					"name": "Neutral 800"
				},
				{
					"slug": "neutral-900",
					"color": "#111111",
					"name": "Neutral 900"
				},
				{
					"slug": "success",
					"color": "#15703c",
					"name": "Success"
				},
				{
					"slug": "warning",
					"color": "#8a5a12",
					"name": "Warning"
				},
				{
					"slug": "error",
					"color": "#b02020",
					"name": "Error"
				}
			]
		},
		"custom": {
			"color": {
				"scrim": "rgba(17, 17, 17, 0.45)",
				"overlay": "rgba(17, 17, 17, 0.08)"
			},
			"radius": {
				"sm": "0",
				"md": "0",
				"lg": "0",
				"pill": "999px"
			}
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"lineHeight": "1.8"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "500",
					"letterSpacing": "-0.01em"
				}
			},
			"h6": {
				"typography": {
					"letterSpacing": "0.16em"
				}
			}
		}
	}
}

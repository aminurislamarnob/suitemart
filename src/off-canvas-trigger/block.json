{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/off-canvas-trigger",
	"title": "Off-canvas Trigger",
	"category": "suitemart",
	"icon": "button",
	"description": "A button that opens an off-canvas panel.",
	"keywords": [ "drawer", "open", "filters", "button" ],
	"textdomain": "suitemart",
	"attributes": {
		"panelId": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"icon": {
			"type": "string",
			"default": "filter"
		},
		"showLabel": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"anchor": true,
		"interactivity": true,
		"html": false,
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalFontWeight": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js"
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/pricing-table",
	"title": "Pricing Plan",
	"category": "suitemart",
	"icon": "tag",
	"description": "One plan in a pricing comparison: name, price, feature list and a call to action.",
	"keywords": [ "pricing", "plan", "tier", "package", "subscription" ],
	"textdomain": "suitemart",
	"attributes": {
		"planName": {
			"type": "string",
			"default": ""
		},
		"planLevel": {
			"type": "number",
			"default": 3
		},
		"currency": {
			"type": "string",
			"default": ""
		},
		"price": {
			"type": "string",
			"default": ""
		},
		"period": {
			"type": "string",
			"default": ""
		},
		"summary": {
			"type": "string",
			"default": ""
		},
		"badge": {
			"type": "string",
			"default": ""
		},
		"featured": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalFontFamily": true
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}

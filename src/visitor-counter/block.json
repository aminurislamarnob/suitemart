{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/visitor-counter",
	"title": "Visitor Counter",
	"category": "suitemart-commerce",
	"icon": "users",
	"description": "Displays a synthetic, randomly generated number of active viewers to create urgency.",
	"keywords": [
		"product",
		"visitors",
		"viewers",
		"counter",
		"urgency"
	],
	"textdomain": "suitemart",
	"usesContext": [
		"postId"
	],
	"attributes": {
		"minVisitors": {
			"type": "number",
			"default": 20
		},
		"maxVisitors": {
			"type": "number",
			"default": 50
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"interactivity": true,
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js"
}

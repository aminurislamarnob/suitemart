{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/testimonial",
	"title": "Testimonial",
	"category": "suitemart",
	"icon": "format-quote",
	"description": "A quote with an attribution, optional portrait and star rating.",
	"keywords": [ "review", "quote", "customer", "rating" ],
	"textdomain": "suitemart",
	"attributes": {
		"quote": {
			"type": "string",
			"default": ""
		},
		"author": {
			"type": "string",
			"default": ""
		},
		"role": {
			"type": "string",
			"default": ""
		},
		"rating": {
			"type": "number",
			"default": 0
		},
		"imageId": {
			"type": "number",
			"default": 0
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"showQuoteMark": {
			"type": "boolean",
			"default": true
		},
		"alignment": {
			"type": "string",
			"enum": [ "start", "center" ],
			"default": "start"
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalFontFamily": true
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}

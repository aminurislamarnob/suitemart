{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/compare-images",
	"title": "Image Comparison",
	"category": "suitemart",
	"icon": "image-flip-horizontal",
	"description": "Two images, one over the other, with a handle that wipes between them. For before and after.",
	"keywords": [ "before", "after", "slider", "wipe", "difference" ],
	"textdomain": "suitemart",
	"attributes": {
		"beforeId": {
			"type": "number",
			"default": 0
		},
		"beforeUrl": {
			"type": "string",
			"default": ""
		},
		"beforeAlt": {
			"type": "string",
			"default": ""
		},
		"beforeLabel": {
			"type": "string",
			"default": ""
		},
		"afterId": {
			"type": "number",
			"default": 0
		},
		"afterUrl": {
			"type": "string",
			"default": ""
		},
		"afterAlt": {
			"type": "string",
			"default": ""
		},
		"afterLabel": {
			"type": "string",
			"default": ""
		},
		"orientation": {
			"type": "string",
			"enum": [ "horizontal", "vertical" ],
			"default": "horizontal"
		},
		"startPosition": {
			"type": "number",
			"default": 50
		}
	},
	"supports": {
		"anchor": true,
		"align": [ "wide", "full" ],
		"html": false,
		"interactivity": true,
		"spacing": {
			"margin": true
		},
		"typography": {
			"fontSize": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js"
}

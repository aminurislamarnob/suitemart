{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/add-to-cart-button",
	"title": "Add to Cart Button",
	"category": "suitemart-commerce",
	"icon": "cart",
	"description": "Adds the product to the cart without leaving the page. Reduces to a single icon, for the action bar on a product card.",
	"keywords": [ "cart", "add to cart", "buy", "product" ],
	"textdomain": "suitemart",
	"usesContext": [ "postId" ],
	"attributes": {
		"appearance": {
			"type": "string",
			"enum": [ "icon", "icon-label" ],
			"default": "icon"
		},
		"iconSize": {
			"type": "number",
			"default": 20
		}
	},
	"supports": {
		"anchor": true,
		"interactivity": true,
		"html": false,
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js"
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/ajax-search",
	"title": "Live Search",
	"category": "suitemart",
	"icon": "search",
	"description": "A search field that suggests results as you type, and works as an ordinary search form without JavaScript.",
	"keywords": [ "search", "ajax", "autocomplete", "live", "products" ],
	"textdomain": "suitemart",
	"attributes": {
		"placeholder": {
			"type": "string",
			"default": ""
		},
		"postType": {
			"type": "string",
			"default": "any"
		},
		"resultLimit": {
			"type": "number",
			"default": 6
		},
		"showImages": {
			"type": "boolean",
			"default": true
		},
		"buttonText": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": true,
		"align": [ "wide" ],
		"interactivity": true,
		"html": false,
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true
		},
		"spacing": {
			"margin": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js"
}

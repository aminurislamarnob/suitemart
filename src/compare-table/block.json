{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/compare-table",
	"title": "Compare Table",
	"category": "suitemart-commerce",
	"icon": "editor-table",
	"description": "Shows the products the visitor added to their comparison list.",
	"keywords": [ "compare", "comparison", "table", "product" ],
	"textdomain": "suitemart",
	"attributes": {
		"showImage": {
			"type": "boolean",
			"default": true
		},
		"showRating": {
			"type": "boolean",
			"default": true
		},
		"showStock": {
			"type": "boolean",
			"default": true
		},
		"showSku": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"anchor": true,
		"interactivity": true,
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js"
}

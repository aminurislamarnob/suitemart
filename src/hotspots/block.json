{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/hotspots",
	"title": "Image Hotspots",
	"category": "suitemart",
	"icon": "location",
	"description": "An image with markers pinned to it. Each marker opens a small panel — a product, a price, a note about that part of the picture.",
	"keywords": [ "pin", "marker", "shoppable", "lookbook", "annotate" ],
	"textdomain": "suitemart",
	"attributes": {
		"mediaId": {
			"type": "number",
			"default": 0
		},
		"mediaUrl": {
			"type": "string",
			"default": ""
		},
		"mediaAlt": {
			"type": "string",
			"default": ""
		},
		"markerStyle": {
			"type": "string",
			"enum": [ "dot", "plus", "number" ],
			"default": "plus"
		},
		"pulse": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"anchor": true,
		"align": [ "wide", "full" ],
		"html": false,
		"spacing": {
			"margin": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"allowedBlocks": [ "suitemart/hotspot" ],
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css"
}

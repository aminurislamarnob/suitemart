{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/infobox",
	"title": "Info Box",
	"category": "suitemart",
	"icon": "info",
	"description": "An icon, a heading and supporting text — for feature lists, service highlights and trust badges.",
	"keywords": [ "feature", "service", "icon", "usp" ],
	"textdomain": "suitemart",
	"attributes": {
		"icon": {
			"type": "string",
			"default": "package"
		},
		"iconSize": {
			"type": "number",
			"default": 32
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"titleLevel": {
			"type": "number",
			"default": 3
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"url": {
			"type": "string",
			"default": ""
		},
		"orientation": {
			"type": "string",
			"enum": [ "vertical", "horizontal" ],
			"default": "vertical"
		},
		"alignment": {
			"type": "string",
			"enum": [ "start", "center", "end" ],
			"default": "start"
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalFontFamily": true
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}

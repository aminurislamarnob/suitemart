{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/tab",
	"title": "Tab",
	"category": "suitemart",
	"icon": "index-card",
	"description": "A single tab panel.",
	"parent": [ "suitemart/tabs" ],
	"textdomain": "suitemart",
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"icon": {
			"type": "string",
			"default": ""
		},
		"tabId": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"interactivity": true,
		"html": false,
		"reusable": false,
		"spacing": {
			"padding": true
		},
		"layout": {
			"allowSwitching": true,
			"allowInheriting": false,
			"default": {
				"type": "constrained"
			}
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}

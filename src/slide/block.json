{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/slide",
	"title": "Slide",
	"category": "suitemart",
	"icon": "images-alt2",
	"description": "A single slide.",
	"parent": [ "suitemart/slider" ],
	"textdomain": "suitemart",
	"attributes": {},
	"supports": {
		"html": false,
		"reusable": false,
		"color": {
			"text": true,
			"background": true
		},
		"spacing": {
			"padding": true,
			"blockGap": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"layout": {
			"allowSwitching": true,
			"allowInheriting": false,
			"default": {
				"type": "constrained"
			}
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/wishlist-grid",
	"title": "Wishlist Grid",
	"category": "suitemart-commerce",
	"icon": "heart",
	"description": "Shows the products the visitor saved to their wishlist.",
	"keywords": [ "wishlist", "favourite", "saved", "product" ],
	"textdomain": "suitemart",
	"attributes": {
		"columns": {
			"type": "number",
			"default": 4
		},
		"showPrice": {
			"type": "boolean",
			"default": true
		},
		"showStock": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"anchor": true,
		"interactivity": true,
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js"
}

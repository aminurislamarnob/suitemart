{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/off-canvas",
	"title": "Off-canvas Panel",
	"category": "suitemart",
	"icon": "align-pull-right",
	"description": "A panel that slides in from the edge of the screen. Holds any blocks — filters, a cart, a menu.",
	"keywords": [ "drawer", "sidebar", "panel", "slide", "filters" ],
	"textdomain": "suitemart",
	"attributes": {
		"panelId": {
			"type": "string",
			"default": ""
		},
		"side": {
			"type": "string",
			"enum": [ "start", "end", "top", "bottom" ],
			"default": "end"
		},
		"size": {
			"type": "string",
			"default": "22rem"
		},
		"title": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": false,
		"interactivity": true,
		"html": false,
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true
		},
		"spacing": {
			"padding": true,
			"blockGap": true
		},
		"layout": {
			"allowSwitching": true,
			"allowInheriting": false,
			"default": {
				"type": "constrained"
			}
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js"
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/size-guide-button",
	"title": "Size Guide Button",
	"category": "suitemart-commerce",
	"icon": "button",
	"description": "A button that opens the product size guide modal.",
	"keywords": [ "size", "guide", "button", "modal" ],
	"textdomain": "suitemart",
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"interactivity": true,
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalFontWeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js"
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/product-gallery",
	"title": "Product Gallery",
	"category": "woocommerce",
	"description": "Displays the product image and gallery thumbnails.",
	"keywords": [
		"product",
		"image",
		"gallery",
		"thumbnails"
	],
	"textdomain": "suitemart",
	"attributes": {
		"layout": {
			"type": "string",
			"default": "horizontal"
		}
	},
	"usesContext": [
		"postId"
	],
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}

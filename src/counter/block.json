{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/counter",
	"title": "Counter",
	"category": "suitemart",
	"icon": "chart-bar",
	"description": "A statistic that counts up when it scrolls into view.",
	"keywords": [ "number", "statistic", "stat", "count", "milestone" ],
	"textdomain": "suitemart",
	"attributes": {
		"start": {
			"type": "number",
			"default": 0
		},
		"end": {
			"type": "number",
			"default": 100
		},
		"duration": {
			"type": "number",
			"default": 2000
		},
		"prefix": {
			"type": "string",
			"default": ""
		},
		"suffix": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"icon": {
			"type": "string",
			"default": ""
		},
		"iconSize": {
			"type": "number",
			"default": 32
		},
		"alignment": {
			"type": "string",
			"enum": [ "start", "center", "end" ],
			"default": "center"
		}
	},
	"supports": {
		"anchor": true,
		"interactivity": true,
		"html": false,
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js"
}

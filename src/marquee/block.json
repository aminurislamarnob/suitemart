{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suitemart/marquee",
	"title": "Marquee",
	"category": "suitemart",
	"icon": "controls-repeat",
	"description": "A strip of content that scrolls sideways, with a pause control.",
	"keywords": [ "ticker", "scroll", "announcement", "strip", "loop" ],
	"textdomain": "suitemart",
	"attributes": {
		"speed": {
			"type": "number",
			"default": 60
		},
		"direction": {
			"type": "string",
			"enum": [ "start", "end" ],
			"default": "end"
		},
		"pauseOnHover": {
			"type": "boolean",
			"default": true
		},
		"ariaLabel": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": true,
		"align": [ "wide", "full" ],
		"interactivity": true,
		"html": false,
		"color": {
			"text": true,
			"background": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"textTransform": true
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js"
}

{
	"name": "suitemart",
	"version": "0.1.0",
	"description": "A multipurpose full site editing block theme for WooCommerce.",
	"author": "Md. Aminur Islam",
	"license": "GPL-3.0-or-later",
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "wp-scripts build --experimental-modules --webpack-src-dir=src --output-path=build",
		"start": "wp-scripts start --experimental-modules --webpack-src-dir=src --output-path=build",
		"lint:js": "wp-scripts lint-js src",
		"lint:js:fix": "wp-scripts lint-js src --fix",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"lint:css:fix": "wp-scripts lint-style \"src/**/*.scss\" --fix",
		"lint:php": "composer exec -- phpcs",
		"lint:php:fix": "composer exec -- phpcbf",
		"analyze:php": "composer exec -- phpstan analyse --memory-limit=1G",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/themes/suitemart vendor/bin/phpunit",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"makepot": "wp i18n make-pot . languages/suitemart.pot --domain=suitemart --exclude=build,node_modules,vendor,tests",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"build:icons": "node tools/build-sprite.mjs",
		"lint:icons": "node tools/build-sprite.mjs --check"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.10.0",
		"@playwright/test": "^1.49.0",
		"@wordpress/env": "^10.14.0",
		"@wordpress/icons": "^15.3.0",
		"@wordpress/scripts": "^30.7.0",
		"lucide-static": "^1.31.0",
		"typescript": "~5.6",
		"webpack-remove-empty-scripts": "^1.1.1"
	},
	"dependencies": {
		"photoswipe": "^5.4.4",
		"swiper": "^11.1.15"
	}
}
